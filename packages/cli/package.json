{
  "name": "@flagrship/cli",
  "version": "0.0.1",
  "description": "Flagrship CLI — manage feature flags from the terminal",
  "license": "MIT",
  "bin": {
    "flagrship": "./dist/flagrship.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/flagrship.js --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.5.0",
    "tsx": "^4.0.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nisarg0330/Flagrship.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Nisarg0330/Flagrship",
  "bugs": "https://github.com/Nisarg0330/Flagrship/issues",
  "author": "Nisarg Patel",
  "keywords": [
    "feature-flags",
    "cli",
    "rollout",
    "feature-toggle"
  ],
  "publishConfig": {
    "access": "public"
  }
}
