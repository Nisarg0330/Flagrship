{
  "name": "flagrship",
  "version": "0.0.1",
  "private": true,
  "description": "Ship without a release. Roll out by percentage. Roll back instantly.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@flagrship/api",
    "build:api": "npm run build --workspace=@flagrship/api",
    "build:cli": "npm run build --workspace=@flagrship/cli",
    "build:sdk": "npm run build --workspace=@flagrship/sdk",
    "dev:landing": "npm run dev --workspace=@flagrship/landing",
    "build:landing": "npm run build --workspace=@flagrship/landing",
    "test": "npm run test:api && npm run test:cli && npm run test:sdk && npm run test:py",
    "test:api": "npm run test --workspace=@flagrship/api",
    "test:cli": "npm run test --workspace=@flagrship/cli",
    "test:sdk": "npm run test --workspace=@flagrship/sdk",
    "test:py": "python -m pytest packages/sdk-python -q",
    "lint": "eslint packages/*/src --ext .ts",
    "typecheck": "tsc --noEmit -p packages/api/tsconfig.json && tsc --noEmit -p packages/cli/tsconfig.json && tsc --noEmit -p packages/sdk-js/tsconfig.json && tsc --noEmit -p packages/landing/tsconfig.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "prisma@6.19.3": true
  }
}
